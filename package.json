{
  "name": "battle-base",
  "version": "1.0.0",
  "description": "ERA DERBY — Every Era. One Pitch. 1v1 Historical Football Draft & Match Simulation.",
  "type": "module",
  "scripts": {
    "build": "npm run build:css",
    "start": "node server.js",
    "build:css": "tailwindcss -i ./public/styles/app.src.css -o ./public/styles/app.css",
    "watch:css": "tailwindcss -i ./public/styles/app.src.css -o ./public/styles/app.css --watch"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
